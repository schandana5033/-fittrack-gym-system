# ==============================================================================
# FitTrack Gym Management System - Environment Configuration
# ==============================================================================

# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=fittrack-dbms-secret-key-2026-secure-gym-system

# MySQL Configuration (Relational Database)
# Host, port, credentials, and database name for structured core gym data
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DB=fittrack_db

# MongoDB Configuration (NoSQL Document Store)
# Connection URI and database name for flexible workout, progress, and activity logs
MONGO_URI=mongodb://localhost:27017/
MONGO_DB=fittrack_nosql
